msgid "Value name"
msgstr "Nom de la valeur"

#: includes/class-saito-swatches-admin.php:657
msgid "Price"
msgstr "Prix"

#: includes/class-saito-swatches-admin.php:658
msgid "Subtitle color"
msgstr "Couleur du sous-titre"

#: includes/class-saito-swatches-admin.php:658
msgid "Empty: the text color, lighter."
msgstr "Vide : la couleur du texte, plus claire."

#: includes/class-saito-swatches-admin.php:659
msgid "Price color"
msgstr "Couleur du prix"

#: includes/class-saito-swatches-admin.php:662
msgid "Colors"
msgstr "Couleurs"

#: includes/class-saito-swatches-admin.php:662
msgid "Leave a color empty to use the one from your theme."
msgstr "Laissez une couleur vide pour utiliser celle de votre thème."

#: includes/class-saito-swatches-admin.php:663
msgid "Border"
msgstr "Bordure"

#: includes/class-saito-swatches-admin.php:664
msgid "Border when selected"
msgstr "Bordure une fois sélectionnée"

#: includes/class-saito-swatches-admin.php:665
msgid "Background"
msgstr "Fond"

#: includes/class-saito-swatches-admin.php:666
msgid "Background when selected"
msgstr "Fond une fois sélectionnée"

#: includes/class-saito-swatches-admin.php:667
msgid "Text"
msgstr "Texte"

#: includes/class-saito-swatches-admin.php:670
#: includes/class-saito-swatches-admin.php:742
msgid "Mobile"
msgstr "Mobile"

#: includes/class-saito-swatches-admin.php:671
