msgstr "Taille originale"

#: includes/class-saito-swatches-admin.php:619
msgid "Image file size"
msgstr "Taille du fichier image"

#: includes/class-saito-swatches-admin.php:619
msgid "The file loaded by the browser. Pick the smallest one that stays sharp."
msgstr "Le fichier chargé par le navigateur. Choisissez le plus petit qui reste net."

#: includes/class-saito-swatches-admin.php:620
msgid "Displayed image height"
msgstr "Hauteur affichée de l’image"

#: includes/class-saito-swatches-admin.php:621
msgid "Color dot and icon size"
msgstr "Taille des pastilles couleur et des icônes"

#: includes/class-saito-swatches-admin.php:622
msgid "Shape of dots and images"
msgstr "Forme des pastilles et des images"

#: includes/class-saito-swatches-admin.php:623
msgid "Opacity of non-selected swatches"
msgstr "Opacité des vignettes non sélectionnées"

#: includes/class-saito-swatches-admin.php:627
