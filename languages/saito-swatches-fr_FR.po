msgstr "Texte du prix unitaire"

#: includes/class-saito-swatches-admin.php:726
msgid "<code>{price}</code> is replaced by the price, formatted with your WooCommerce currency settings."
msgstr "<code>{price}</code> est remplacé par le prix, au format de devise de WooCommerce."

